{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "paths": {
      "$src": ["./src"],
      "$src/*": ["./src/*"],
      "$wails/*": ["./wailsjs/*"]
    },
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "src/constant/default-criteria.json"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
